# Copie para .env na VM e preencha. NUNCA suba o .env para o GitHub.
# (o .gitignore já bloqueia .env e *service-account*.json)

# Domínio HTTPS que aponta para o IP público da VM (ex.: DuckDNS, grátis).
DOMAIN=seu-subdominio.duckdns.org

# Segredo estável do Flask (gere um aleatório e não mude depois).
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque_por_um_valor_aleatorio_longo

# Painel administrativo (protege toda a interface, menos /healthz e o webhook).
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=uma_senha_com_pelo_menos_12_caracteres

# IA do chatbot (NVIDIA).
NVIDIA_ENABLED=true
NVIDIA_ENDPOINT=openai
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=coloque_sua_chave_nvapi

# Google Sheets (o arquivo vai em ./secrets/google-service-account.json).
GOOGLE_SPREADSHEET_ID=coloque_o_id_da_planilha
WHATSAPP_SHEET_NAMES=
WHATSAPP_RESTORE_FROM_GOOGLE=true
WHATSAPP_MEMORY_HOURS=24

# WhatsApp / Meta — preencha só quando for ligar o WhatsApp de verdade.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=
