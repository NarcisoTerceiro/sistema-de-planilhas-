PYTHON_VERSION=3.11.9
HOST=0.0.0.0
DATA_FORMULATOR_HOME=/tmp/data_formulator
WORKSPACE_BACKEND=local
DF_ALLOW_PLUGINS=1
DISABLE_DISPLAY_KEYS=true
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=PREENCHA_SENHA_FORTE
FLASK_SECRET_KEY=PREENCHA_SEGREDO_ALEATORIO_ESTAVEL
GROQ_ENABLED=true
GROQ_ENDPOINT=openai
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODELS=llama-3.3-70b-versatile
GROQ_API_KEY=PREENCHA
NVIDIA_ENABLED=true
NVIDIA_ENDPOINT=openai
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=PREENCHA
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/google-service-account.json
GOOGLE_SPREADSHEET_ID=PREENCHA_ID_MANUALMENTE_NO_RENDER
WHATSAPP_SHEET_NAMES=
WHATSAPP_RESTORE_FROM_GOOGLE=true
WHATSAPP_MEMORY_HOURS=24
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=PREENCHA
WHATSAPP_PHONE_NUMBER_ID=PREENCHA
WHATSAPP_GRAPH_VERSION=PREENCHA_VERSAO_META
META_APP_SECRET=PREENCHA
WHATSAPP_VERIFY_TOKEN=PREENCHA
